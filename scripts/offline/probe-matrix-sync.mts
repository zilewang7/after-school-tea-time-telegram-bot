/**
 * Offline cases for the probe menu-matrix snapshot (AGENTS harness rule).
 *
 * The probe CLI must not import `src/`: a script importing src has to import the
 * offline harness first, whose DB_PATH rewrite would break the probe's
 * test-instance gate. The matrix therefore lives in `scripts/probe/menu-matrix.mts`
 * and is regenerated by `scripts/probe/refresh-menu-matrix.mts`. These cases make
 * a stale snapshot fail: they compare it with the runtime menu and capability
 * seed, compare the file on disk with what the refresher would write, and guard
 * that no other probe file drifts back into importing src.
 *
 * Run: `npx tsx scripts/offline/probe-matrix-sync.mts`
 */
import { readdirSync, readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { expect, reportResults, runCase, type CaseResult } from './harness.mts';
import { capabilitySeedOf } from '../../src/config/model-capability-seed.js';
import { platformOfModelId } from '../../src/config/model-catalog.js';
import { modelConfigs } from '../../src/config/models.js';
import { isProbePlatform } from '../probe/effort-types.mts';
import { MENU_MATRIX, type MenuMatrixEntry } from '../probe/menu-matrix.mts';
import { MENU_MATRIX_SOURCE_PATH, renderCurrentMenuMatrixFile } from '../probe/refresh-menu-matrix.mts';

const PROBE_DIR = fileURLToPath(new URL('../probe/', import.meta.url));
const REFRESH_FILE = 'refresh-menu-matrix.mts';
const REFRESH_COMMAND = 'npx tsx scripts/probe/refresh-menu-matrix.mts';

const results: CaseResult[] = [];

/** The matrix the runtime menu + capability seed describe, derived independently of the snapshot builder */
const expectedEntries = (): readonly MenuMatrixEntry[] =>
    modelConfigs.map((config) => {
        const reasoning = capabilitySeedOf(config.id)?.reasoning;
        const platform = platformOfModelId(config.id);
        if (!isProbePlatform(platform)) throw new Error(`no probe platform for ${config.id} (${platform})`);
        return {
            model: config.id,
            platform,
            vendorEfforts: reasoning?.efforts ?? [],
            vendorDefaultEffort: reasoning?.defaultEffort ?? null,
            vendorToggle: reasoning?.toggle === true,
            vendorDefaultEnabled: reasoning?.defaultEnabled ?? null,
        };
    });

const updaterHint = `menu changed without refreshing the snapshot: run \`${REFRESH_COMMAND}\``;

/** A readable per-model difference list; empty when the two matrices match */
const differencesOf = (
    actual: readonly MenuMatrixEntry[],
    expected: readonly MenuMatrixEntry[]
): readonly string[] => {
    const problems: string[] = [];
    const expectedById = new Map(expected.map((entry) => [entry.model, entry]));
    const actualIds = actual.map((entry) => entry.model);
    const expectedIds = expected.map((entry) => entry.model);
    if (JSON.stringify(actualIds) !== JSON.stringify(expectedIds)) {
        problems.push(`ids/order: snapshot [${actualIds.join(', ')}] vs runtime [${expectedIds.join(', ')}]`);
    }
    for (const entry of actual) {
        const wanted = expectedById.get(entry.model);
        if (wanted === undefined) {
            problems.push(`${entry.model}: not in the runtime menu`);
            continue;
        }
        const fields: (keyof MenuMatrixEntry)[] = [
            'platform',
            'vendorEfforts',
            'vendorDefaultEffort',
            'vendorToggle',
            'vendorDefaultEnabled',
        ];
        for (const field of fields) {
            if (JSON.stringify(entry[field]) !== JSON.stringify(wanted[field])) {
                problems.push(`${entry.model}.${field}: snapshot ${JSON.stringify(entry[field])} vs runtime ${JSON.stringify(wanted[field])}`);
            }
        }
    }
    return problems;
};

// ---------------------------------------------------------------------------
// 1. The snapshot is the runtime menu
// ---------------------------------------------------------------------------

results.push(
    await runCase('snapshot: menu-matrix.mts equals the runtime menu + capability seed', () => {
        const expected = expectedEntries();
        const problems = differencesOf(MENU_MATRIX, expected);
        expect(problems.length === 0, `${problems.slice(0, 6).join('; ')} (${updaterHint})`);
        expect(MENU_MATRIX.length === modelConfigs.length, `one row per menu model (got ${MENU_MATRIX.length}, expected ${modelConfigs.length})`);
        expect(new Set(MENU_MATRIX.map((entry) => entry.model)).size === MENU_MATRIX.length, 'no duplicate model ids');
    })
);

results.push(
    await runCase('snapshot: covers the menu, no non-menu or image ids', () => {
        const ids = MENU_MATRIX.map((entry) => entry.model);
        expect(ids.length === 13, `13 menu models in the snapshot (got ${ids.length})`);
        expect(ids.includes('gpt-6-sol'), 'gpt-6-sol is in the menu and in the snapshot');
        for (const nonMenu of ['gpt-6.1-sol', 'gpt-6.1-terra', 'claude-fable-5-2', 'gemini-3.8-flash']) {
            expect(!ids.includes(nonMenu), `${nonMenu} is not a menu model and must stay out`);
        }
        for (const imageModel of ['gemini-nano-banana-2.1', 'gpt-image-2.5-dev']) {
            expect(!ids.includes(imageModel), `image model ${imageModel} is not part of the probe matrix`);
        }
        for (const entry of MENU_MATRIX) {
            if (entry.vendorToggle) {
                expect(
                    entry.vendorDefaultEnabled === null || typeof entry.vendorDefaultEnabled === 'boolean',
                    `${entry.model}: a toggle model keeps its enabled default or null`
                );
            } else {
                expect(entry.vendorDefaultEnabled === null, `${entry.model}: a non-toggle model has no enabled default`);
            }
        }
    })
);

// ---------------------------------------------------------------------------
// 2. The file on disk is reproducibly rendered
// ---------------------------------------------------------------------------

results.push(
    await runCase('snapshot: the file on disk is exactly what the refresher renders', () => {
        const onDisk = readFileSync(MENU_MATRIX_SOURCE_PATH, 'utf8');
        const rendered = renderCurrentMenuMatrixFile(MENU_MATRIX);
        expect(
            onDisk === rendered,
            `menu-matrix.mts formatting/content is stale (${updaterHint})`
        );
        expect(onDisk.includes(REFRESH_COMMAND), 'the header names the refresh command');
        expect(onDisk.includes('Generated on '), 'the header names its generation date');
    })
);

// ---------------------------------------------------------------------------
// 3. Only the refresher may import src
// ---------------------------------------------------------------------------

results.push(
    await runCase('probe scripts: only the refresher imports src', () => {
        const offenders: string[] = [];
        for (const file of readdirSync(PROBE_DIR)) {
            if (!file.endsWith('.mts') || file === REFRESH_FILE) continue;
            const source = readFileSync(`${PROBE_DIR}${file}`, 'utf8');
            const staticImport = /from\s+['"][^'"]*src\//g.test(source);
            const dynamicImport = /import\s*\(\s*['"][^'"]*src\//g.test(source);
            if (staticImport || dynamicImport) offenders.push(file);
        }
        expect(
            offenders.length === 0,
            `probe files must not import src (only ${REFRESH_FILE} may): ${offenders.join(', ')}`
        );
    })
);

reportResults(results);
