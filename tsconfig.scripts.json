{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "rootDir": ".",
    "sourceMap": false
  },
  "include": ["scripts", "webapp/scripts", "src/env.d.ts"],
  "exclude": ["node_modules", "dist", "tgs-converter", "docs", "scripts/offline/webapp-*.mts"]
}
