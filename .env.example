# ===== Bot =====
BOT_TOKEN=
BOT_USER_ID=
BOT_NAME=
BOT_USER_NAME=

# ===== AI platforms =====
OPENAI_API_KEY=
OPENAI_API_URL=
# Gemini runs on Vertex AI. Express mode (apiKey) by default; auto-switches to
# full Vertex (ADC) when a real ./gcp-sa.json is present — required for GCS.
# Optional: set GEMINI_API_URL (e.g. an API relay) together with GEMINI_API_KEY
# to route Gemini there instead — the URL takes precedence over Vertex.
GEMINI_API_URL=
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
DEEPSEEK_API_URL=
DEEPSEEK_API_KEY=
PICZIT_ENDPOINT=

# ===== Behavior =====
# Preference/persona layer of the system prompt only (role, tone, reply
# language) — the message format protocol, current time/model and OCR notes
# are built into the code (src/ai/system-prompt/). SYSTEM_PROMPT here, or the
# markdown file named by SYSTEM_PROMPT_FILE, may reference the bot's own
# identity as {{BOT_USER_NAME}} / {{BOT_NAME}}, so one prompt serves both the
# production and the test bot.
SYSTEM_PROMPT=
DEFAULT_MODEL=
# 用户分级开关：缺省/空 = 开启（体验用户只能用 gemini-4-hydrogen、banana 生图，
# 付费命令/工具需申请准入）；0 = 关闭，所有人按完整权限处理（回滚用）。
# full 用户 = OWNER_USER_ID、名单群的当前成员、TOOL_CHAT_IDS 里的正数用户 id（私聊）、
# 以及被批准准入的用户；名单群成员被踢/退群后自动降为体验用户。
ACCESS_TIERS=
# 名单群（逗号分隔的负数群 id）：这些群的当前成员自动拥有完整功能，私聊和面板用
# getChatMember 实时校验。留空 = 取 TOOL_CHAT_IDS 里的负数群 id。
ACCESS_GROUP_IDS=
# JSON object keyed by server name. Optional "excludePlatforms" keeps a server's
# tools from the listed platforms; an unknown key skips that server. Example:
#   {"search":{"serverUrl":"https://mcp.example.com/mcp","excludePlatforms":["gemini","grok"]}}
MCP_SERVERS=

# ===== Model tools (optional) =====
# Comma-separated chat ids where send_sms_to_owner / generate_image are offered.
TOOL_CHAT_IDS=
# Comma-separated tool names or MCP server names (MCP_SERVERS keys) to turn off.
DISABLED_TOOLS=
# Archive tools: chats whose history luoxu indexes (search_history/read_history).
# They are declared only in these chats; luoxu is reached via LUOXU_PREVIEW_URL.
HISTORY_CHAT_IDS=
# 0 turns off search_history / read_history.
HISTORY_TOOLS=
# 0 turns off Gemini's client tools; only its built-in search tools remain.
GEMINI_CLIENT_TOOLS=
# Owner that send_sms_to_owner reaches: Telegram user id, name, chat nickname.
OWNER_USER_ID=
OWNER_DISPLAY_NAME=
OWNER_SHORT_NAME=
# Owner SMS MCP endpoint + Bearer token; an empty URL disables send_sms_to_owner.
OWNER_SMS_MCP_URL=
OWNER_SMS_MCP_TOKEN=
# 1 re-enables SMS on a TEST_INSTANCE=1 container (off there by default).
OWNER_SMS_ALLOW_TEST=
# 0 turns off search_images / fetch_image / send_image (generate_image stays).
IMAGE_TOOLS=
# SearXNG JSON API; default http://searxng:8080 on this compose network.
IMAGE_SEARCH_URL=
# Comma-separated SearXNG engines; empty = the instance's own defaults.
IMAGE_SEARCH_ENGINES=
# 0 / 1 / 2; fixed for the model, never a tool argument. Default 1.
IMAGE_SEARCH_SAFESEARCH=
# 0 stops image generation from declaring searchTypes.imageSearch.
IMAGE_SEARCH_GROUNDING=
# 0 turns off search_by_image (Yandex reverse image search); on by default.
IMAGE_REVERSE_SEARCH=

# ===== Network =====
# SOCKS5 proxy for the cloud Bot API (bypassed when TG_LOCAL_API_ROOT is set).
BOT_PROXY=

# ===== Optional services (docker compose profiles) =====
# Comma-separated profiles to start. 'tgs' = tgs-converter (animated-sticker
# rendering, recommended default). Add 'bigfile' to also run the local Bot API
# server for >20MB media, e.g.  COMPOSE_PROFILES=tgs,bigfile
COMPOSE_PROFILES=tgs
TGS_CONVERTER_URL=http://tgs-converter:8080

# Custom emoji visual context (uses tgs-converter for PNG previews/atlases).
CUSTOM_EMOJI_ENABLED=1
CUSTOM_EMOJI_PER_MESSAGE=8
CUSTOM_EMOJI_CONTEXT_LIMIT=16
# Raw PNG bytes per model request; 512 KiB stays below 1 MiB after base64.
CUSTOM_EMOJI_CONTEXT_BYTES=524288
# Atlas work is fail-open and leaves the reply path after this total deadline.
CUSTOM_EMOJI_CONTEXT_TIMEOUT_MS=1500
# Global bounded acquisition pools and persisted-pending recovery.
CUSTOM_EMOJI_PREVIEW_CONCURRENCY=3
CUSTOM_EMOJI_ACQUISITION_CONCURRENCY=3
CUSTOM_EMOJI_ACQUISITION_QUEUE=64
CUSTOM_EMOJI_TELEGRAM_CONCURRENCY=3
CUSTOM_EMOJI_TELEGRAM_QUEUE=64

# ===== Large media (optional; needs 'bigfile' in COMPOSE_PROFILES) =====
# Default (the four vars below empty): cloud getFile 20MB, Gemini express,
# files >20MB skipped — identical to current behavior.
# To enable end-to-end:
#   1. add bigfile into like COMPOSE_PROFILES=tgs,bigfile  (above)
#   2. drop a real service-account JSON at ./gcp-sa.json
#   3. set GOOGLE_CLOUD_PROJECT (above) to that SA's project
TG_LOCAL_API_ROOT=http://telegram-bot-api:8081
# Media download cap, e.g. 300M (needs TG_LOCAL_API_ROOT for >20M; local mode allows up to 2G)
# MAX_MEDIA_BYTES=300M
TG_API_ID=
TG_API_HASH=
GCS_BUCKET=

# ===== Link preview via luoxu (optional) =====
# luoxu's api container must join the shared docker network as
# 'luoxu-api'. Empty → link previews are skipped entirely.
LUOXU_PREVIEW_URL=http://luoxu-api:9008/luoxu

# ===== Trigger batching (optional) =====
# Sliding window (ms) that merges a burst of trigger messages from one user
# (forwarded batch, album + typed question, a long paste the client split into
# several messages) into a single reply. Default 500.
# MENTION_BATCH_WINDOW_MS=500

# ===== Control panel (Mini App) =====
# WEBAPP_PORT, WEBAPP_PUBLIC_URL and WEBAPP_BOT_SHORT_NAME belong in each
# service's `environment:` in docker-compose.yaml, NOT in this file: the test
# instance loads .env through dotenv too and would inherit the production URL.
# Unset WEBAPP_PORT = no panel server and /panel answers 「面板未启用」.
#   WEBAPP_PORT=8080                                  # HTTP port behind Traefik
#   WEBAPP_PUBLIC_URL=https://miniapp.example.com     # private-chat web_app button
#   WEBAPP_BOT_SHORT_NAME=panel                       # BotFather /newapp short name (group Direct Links)

# ===== Chat HTML widgets (Telegram 13.2 HTMLBubbles; Phase 0: default off) =====
# send_widget / get_ui_guide stay unregistered unless WIDGET_ENABLE=1. The
# readiness probe logs what the Bot API currently supports; /widget_status and
# /widget_probe (owner) show the same without touching config.
# WIDGET_ENABLE=0
# WIDGET_CHAT_IDS=                       # empty = follow TOOL_CHAT_IDS
# WIDGET_ALLOW_HTML=0                    # 1 = the model may write full HTML; default A2UI subset only
# WIDGET_API_ROOT=https://api.telegram.org
# WIDGET_READY_CHECK=1
# WIDGET_PROBE_CHAT_ID=
# WIDGET_MAX_HTML_BYTES=32768
# WIDGET_MAX_GZIP_BYTES=4096
# Widget render sidecar (docker compose service widget-render). Empty = rendering off.
# WIDGET_RENDER_URL=http://widget-render:8099
# 0 = no browser login (/web, POST /api/auth/code); the page keeps the Telegram entry only
# WEB_LOGIN=1
# 1 = groups get a Mini App link + large preview instead of a widget/image (needs SHARE_ENABLED)
# WIDGET_GROUP_FALLBACK=0
# 0 = public share pages and the share API are off
# SHARE_ENABLED=1
# Optional HMAC secret for share links; defaults to one derived from BOT_TOKEN
# WEBAPP_SHARE_SECRET=

# ===== Model workspace (draft files, per conversation; default off) =====
# A per-conversation virtual file system in SQLite: the model writes drafts,
# reads them back later, renders HTML/A2UI drafts as PNG to look at them, and
# sends them with send_file / send_widget. Rows expire 7 days after their last
# use, cleaned by the hourly clearExpiredData.
# WORKSPACE_ENABLE=0                     # 1 = offer workspace_write/read/list/find/edit/copy/delete/preview and leave_handoff
# WORKSPACE_CHAT_IDS=                    # empty = follow TOOL_CHAT_IDS
# WORKSPACE_MAX_FILE_BYTES=1048576       # 1 MB per file
# WORKSPACE_MAX_CONVERSATION_BYTES=10485760  # 10 MB per conversation
# WORKSPACE_MAX_FILES=100                # files per conversation
# WORKSPACE_MAX_GLOBAL_BYTES=1073741824  # 1 GB across all conversations
# WORKSPACE_PREVIEWS_PER_REPLY=6         # render previews one reply may ask for
